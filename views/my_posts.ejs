<%- include('partials/header', { title: 'My Posts' }) %>

<%# The logged-in user's own posts. `posts` comes from GET /posts in routes/posts.js. %>
<main class="container my_posts">
    <div class="my_posts_header">
        <h1>My posts</h1>
        <a class="buttons" href="/publish">Publish article</a>
    </div>

    <% if (posts.length === 0) { %>
        <p class="my_posts_empty">You haven't published anything yet.</p>
    <% } else { %>
        <%# Uses the home page's .news_cards grid and .card / .card_tag styles. Each card has Edit (GET /posts/:id/edit) and Delete;
            `my_post_list` and `data-post-id` let public/script.js delete a card. %>
        <div class="news_cards my_post_list">
            <% posts.forEach(post => { %>
                <article class="card" data-post-id="<%= post.id %>">
                        <span class="card_tag"><%= post.category %></span>
                        <h3><%= post.title %></h3>
                        <p><%= post.content %></p>
                        <small>Published <%= post.createdAt %></small>
                        <% if (post.updatedAt) { %>
                        <small>· Edited <%= post.updatedAt %></small> <% } %><br>
                        <button type="button" class="delete_post buttons">Delete</button>
                        <a class="buttons" href="/posts/<%= post.id %>/edit">Edit</a>
                </article>
            <% }) %>
        </div>
    <% } %>
</main>

<%- include('partials/footer') %>
