<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Fly High Ventures Blog</title>
    <%# Dancing Script: handwritten font for the hero greeting (#hero_greeting in style.css). %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <nav class="nav_bar container"> 
        <div class="nav_bar_left container nav_prop">
            <img src="/images/logo.png" alt="logo" width="100px" height="70px">
        </div>

        <div class="nav_bar_middle container nav_prop">
            <a class="nav_link" href="/">Home</a>
            <a class="nav_link" href="#">Articles</a>
            <a class="nav_link" href="#">News</a>
            <a class="nav_link" href="#">Personal</a>
            <a class="nav_link" href="#">Innovations</a>
            <a class="nav_link" href="#">Opportunities</a>
        </div>

        <div class="nav_bar_right container nav_prop">
            <search>
                <form action="/search" method="get">
                    <input type="search" name="search" placeholder="Type to search">
                    <button type="submit">🔎</button>
                </form>
            </search>
            <%# Logout is a POST route (routes/auth.js), so it needs a form rather than a link. Only shown when logged in. %>
            <% if (locals.user) { %>
            <form action="/logout" method="post" class="nav_logout">
                <button type="submit">Logout</button>
            </form>
            <%}%>
            <select id="language">
                <option value="en">🇬🇧</option>
            </select>
        </div>
    </nav>
