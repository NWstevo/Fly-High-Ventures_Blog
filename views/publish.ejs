<%- include('partials/header', { title: 'Publish' }) %>

<main class="container publish_page">
    <h1>Publish an article</h1>

    <form action="/publish" method="post" class="publish_form">
        <input type="text" name="title" placeholder="Title" required>

        <select name="category">
            <option value="General">General</option>
            <option value="Tech news">Tech News</option>
            <option value="Innovation">Innovations</option>
            <option value="Opportunity pathways">Opportunity pathways</option>
        </select>

        <textarea name="content" rows="20" placeholder="Write your article" required></textarea>

        <button type="submit">Publish</button>
    </form>
</main>

<%- include('partials/footer') %>