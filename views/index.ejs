
<%- include('partials/header', {title: 'Home' }) %>

        <header class="Header container">
            <div class="hero_title container">
                <p id="hero_text">Fly-High <span id="hero_blog">Blog</span></p>
                <%# Greeting for logged-in users; `user` comes from middlewares/loadUser.js. %>
                <% if (locals.user) { %>
                <p id="hero_greeting">Hi <%= user.name %></p>
                <% } %>
                <div id="styled_hero_text">Ventures</div>
                <p id="intro">Make your ideas an experience by being current with Tech TRENDS!</p>
                <div class="publish">
                    <p id="signup_text">Want to publish your article? </p>
                    <a class="buttons" href="<%=locals.user ? '/publish' : '#' %>" id="get_started">Get Started</a>
                </div>
            </div>
            <%# Only shown when nobody is logged in; logged-in users get a greeting in the hero above and Logout in the nav bar (partials/header.ejs). %>
            <% if (!locals.user) { %>
            <div class="signup ">
                <button class="buttons" type="submit" id="login">Login</button>
                <button class="buttons" type="submit" id="signup">Sign Up</button>
            </div>
            <% } %>
        </header>

        <%# Login/sign-up modal, opened by script.js. Forms POST to routes/auth.js; input names become req.body keys.
            Only rendered for signed-out visitors; script.js skips its modal code when it is missing. %>
        <% if (!locals.user) { %>
        <div id="auth_modal" class="modal" hidden>
            <div class="auth_box">
                <button type="button" id="auth_close" class="auth_modal_close" aria-label="Close">×</button>

                <%# data-tab must match a key of `panels` in script.js. %>
                <div class="tabs">
                    <button type="button" class="tab active" data-tab="login">Login</button>
                    <button type="button" class="tab" data-tab="signup">Sign Up</button>
                </div>

                <form id="login_tab" class="panel" action="/login" method="post">
                    <input type="email" name="email" placeholder="Email" required>
                    <input type="password" name="password" placeholder="Password" required>
                    <button type="submit">Log in</button>
                </form>

                <form id="signup_tab" class="panel" action="/signup" method="post" hidden>
                    <input type="text" name="name" placeholder="Name" required>
                    <input type="email" name="email" placeholder="Email" required>
                    <input type="password" name="password" placeholder="Password" required>
                    <button type="submit">Create account</button>
                </form>                   
                
            </div>
        </div>
        <% } %>
        
        <div class="article container"> <!--This will be animated to scroll from left to right at 0.5 secs-->
            <div class="categories">
                <a class="buttons" href="#">All</a>
                <a class="buttons" href="#">Tech News</a>
                <a class="buttons" href="#">Innovations</a>
                <a class="buttons" href="#">Personal Articles</a>
                <a class="buttons" href="#">Opportunitiy pathways</a>
                <form action="search" method="get"><input type="text" name="article_search" placeholder="search Articles"></form>
            </div>
        </div>

