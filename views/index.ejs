
<%- include('partials/header', {title: 'Home' }) %>

        <header class="Header container">
            <div class="hero_title container">
                <p id="hero_text">Fly-High <span id="hero_blog">Blog</span></p>
                <%# Greeting for logged-in users; `user` comes from middlewares/loadUser.js. %>
                <% if (locals.user) { %>
                <p id="hero_greeting">Hi <%= user.name %></p>
                <% } %>
                <div id="styled_hero_text">Ventures</div>
                <p id="intro">Make your ideas an experience by being current with Tech TRENDS!</p>
                <div class="publish">
                    <p id="signup_text">Want to publish your article? </p>
                    <a class="buttons" href="<%=locals.user ? '/publish' : '#' %>" id="get_started">Get Started</a>
                </div>
            </div>
            <%# Only shown when nobody is logged in; logged-in users get a greeting in the hero above and Logout in the nav bar (partials/header.ejs). %>
            <% if (!locals.user) { %>
            <div class="signup ">
                <button class="buttons" type="submit" id="login">Login</button>
                <button class="buttons" type="submit" id="signup">Sign Up</button>
            </div>
            <% } %>
        </header>

        <%# Login/sign-up modal, opened by script.js. Forms POST to routes/auth.js; input names become req.body keys.
            Only rendered for signed-out visitors; script.js skips its modal code when it is missing. %>
        <% if (!locals.user) { %>
        <div id="auth_modal" class="modal" hidden>
            <div class="auth_box">
                <button type="button" id="auth_close" class="auth_modal_close" aria-label="Close">×</button>

                <%# data-tab must match a key of `panels` in script.js. %>
                <div class="tabs">
                    <button type="button" class="tab active" data-tab="login">Login</button>
                    <button type="button" class="tab" data-tab="signup">Sign Up</button>
                </div>

                <form id="login_tab" class="panel" action="/login" method="post">
                    <input type="email" name="email" placeholder="Email" required>
                    <input type="password" name="password" placeholder="Password" required>
                    <button type="submit">Log in</button>
                </form>

                <form id="signup_tab" class="panel" action="/signup" method="post" hidden>
                    <input type="text" name="name" placeholder="Name" required>
                    <input type="email" name="email" placeholder="Email" required>
                    <input type="password" name="password" placeholder="Password" required>
                    <button type="submit">Create account</button>
                </form>                   
                
            </div>
        </div>
        <% } %>
        
        <div class="article container">
            <%# Category filter: each link reloads / with ?category=..., which app.js passes to getAllPosts().
                The value must match the <option value> in publish.ejs exactly (the database comparison is case-sensitive).
                `activeCategory` (from app.js) marks the current category's button as .active. %>
            <div class="categories">
                <a class="buttons <%= activeCategory === 'All' ? 'active' : '' %>" href="/">All</a>
                <a class="buttons <%= activeCategory === 'Tech news' ? 'active' : '' %>" href="/?category=Tech news">Tech News</a>
                <a class="buttons <%= activeCategory === 'Innovation' ? 'active' : '' %>" href="/?category=Innovation">Innovations</a>
                <%# Only for logged-in users: links to their own posts (GET /posts in routes/posts.js, which needs a login). %>
                <% if (locals.user) { %>
                <a class="buttons" href="/posts">Personal Articles</a>
                <% } %>
                <a class="buttons <%= activeCategory === 'Opportunity pathways' ? 'active' : '' %>" href="/?category=Opportunity pathways">Opportunity pathways</a>
            </div>
        </div>

        <main class="container">
            <div class="news">
                <%# One card per post. `posts` comes from GET / in app.js (all posts, or one category), and each post
                    includes `authorName` from the users table (data/postQueries.js).
                    Posts have no image of their own, so each category gets a fixed picture from public/images.
                    The keys of `categoryImages` must match the <option value>s in publish.ejs exactly;
                    any other category (General, or old ones like IT News) uses `defaultImage`. %>
                <% if (posts.length === 0) { %>
                    <p class="my_posts_empty">No articles in this category yet.</p>
                <% } else { %>
                <%
                    const categoryImages = {
                        'Tech news': 'tech.jpeg',
                        'Innovation': 'innovation.jpeg',
                        'Opportunity pathways': 'opportunity.jpeg',
                    };
                    const defaultImage = 'bg-image.png';
                %>
                <div class="news_cards">
                    <% posts.forEach(post => { %>
                    <div class="card">
                        <img src="/images/<%= categoryImages[post.category] || defaultImage %>" alt="<%= post.title %>">
                        <div class="card_text">
                            <span class="card_tag"><%= post.category %></span>
                            <h3><%= post.title %></h3>
                            <small class="card_author">By <%= post.authorName %></small>
                            <p class="card_excerpt"><%= post.content %></p>
                            <a href="/posts/<%= post.id %>">Read more →</a>
                        </div>
                    </div>
                    <% }) %>
                </div>
                <% } %>
            </div>

        </main>

        <%- include('partials/footer') %>